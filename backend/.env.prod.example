# Прод-окружение. Скопируй в .env.prod и заполни секреты.
PROJECT_NAME=MentorBGITU
API_V1_PREFIX=/api
DEBUG=false

# ВАЖНО: задай длинный случайный ключ (например: openssl rand -hex 32)
SECRET_KEY=ЗАМЕНИ_НА_СЛУЧАЙНУЮ_СТРОКУ
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Фронт и API на одном домене — CORS можно ограничить доменом
BACKEND_CORS_ORIGINS=https://bgitumentor.ru,https://www.bgitumentor.ru

# База данных
POSTGRES_USER=mentor
POSTGRES_PASSWORD=ЗАМЕНИ_НА_СИЛЬНЫЙ_ПАРОЛЬ
POSTGRES_DB=mentorbgitu
POSTGRES_HOST=db
POSTGRES_PORT=5432
