# Автоматический HTTPS (Let's Encrypt) для домена.
bgitumentor.ru, www.bgitumentor.ru {
	encode gzip zstd

	# API → бэкенд
	handle /api/* {
		reverse_proxy api:8000
	}

	# Статика фронта + SPA-роутинг (несуществующие пути → index.html)
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
